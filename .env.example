# Run: gis-admin env   (creates .env with random credentials; never commit it)
POSTGRES_PASSWORD=<POSTGRES_PASSWORD>
GIS_READER_PASSWORD=<GIS_READER_PASSWORD>
GIS_INGEST_PASSWORD=<GIS_INGEST_PASSWORD>
GIS_MONITOR_PASSWORD=<GIS_MONITOR_PASSWORD>
API_KEY=<API_KEY>
# Docker uses 55432; native PostgreSQL uses 5432. Change host URLs to switch.
ADMIN_DATABASE_URL=postgresql://postgres:<POSTGRES_PASSWORD>@127.0.0.1:55432/gis_lab
DATABASE_URL=postgresql://gis_reader:<GIS_READER_PASSWORD>@127.0.0.1:55432/gis_lab
INGEST_DATABASE_URL=postgresql://gis_ingest:<GIS_INGEST_PASSWORD>@127.0.0.1:55432/gis_lab
MONITOR_DATABASE_URL=postgresql://gis_monitor:<GIS_MONITOR_PASSWORD>@127.0.0.1:55432/gis_lab
